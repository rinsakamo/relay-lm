+bool llama_debug_dump_kv_prefix(
+        llama_context * ctx,
+        llama_seq_id seq_id,
+        llama_pos p0,
+        llama_pos p1,
+        const char * out_dir,
+        const char * tag) {
+    if (ctx == nullptr || out_dir == nullptr || tag == nullptr || tag[0] == '\0') {
+        return false;
+    }
+
+    ctx->synchronize();
+
+    auto * iswa = dynamic_cast<llama_kv_cache_iswa *>(ctx->get_memory());
+    if (iswa == nullptr) {
+        LLAMA_LOG_ERROR("%s: target memory is not iSWA KV memory\n", __func__);
+        return false;
+    }
+
+    const std::filesystem::path root = std::filesystem::path(out_dir) / tag;
+    if (std::filesystem::exists(root)) {
+        LLAMA_LOG_ERROR("%s: refusing to overwrite existing diagnostic dump: %s\n",
+                __func__, root.string().c_str());
+        return false;
+    }
+
+    std::error_code ec;
+    std::filesystem::create_directories(root, ec);
+    if (ec) {
+        LLAMA_LOG_ERROR("%s: failed to create dump root %s: %s\n",
+                __func__, root.string().c_str(), ec.message().c_str());
+        return false;
+    }
+
+    if (!iswa->get_base()->debug_dump_seq_prefix(root.string().c_str(), "base", seq_id, p0, p1)) {
+        return false;
+    }
+    if (!iswa->get_swa()->debug_dump_seq_prefix(root.string().c_str(), "swa", seq_id, p0, p1)) {
+        return false;
+    }
+
+    return true;
+}
 
