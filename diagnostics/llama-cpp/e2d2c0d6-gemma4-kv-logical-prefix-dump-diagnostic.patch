+bool llama_kv_cache::debug_dump_seq_prefix(
+        const char * dir,
+        const char * cache_name,
+        llama_seq_id seq_id,
+        llama_pos p0,
+        llama_pos p1) const {
+    if (dir == nullptr || cache_name == nullptr || p0 < 0 || p1 <= p0) {
+        LLAMA_LOG_ERROR("%s: invalid arguments\n", __func__);
+        return false;
+    }
+    if (seq_id < 0 || (size_t) seq_id >= seq_to_stream.size()) {
+        LLAMA_LOG_ERROR("%s: invalid seq_id %d\n", __func__, seq_id);
+        return false;
+    }
+    if (v_trans) {
+        LLAMA_LOG_ERROR("%s: diagnostic expects non-transposed V cache (Flash Attention ON)\n", __func__);
+        return false;
+    }
+
+    const uint32_t stream = seq_to_stream[seq_id];
+    const auto & cells = v_cells[stream];
+
+    std::vector<std::pair<llama_pos, uint32_t>> rows;
+    rows.reserve((size_t) (p1 - p0));
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (!cells.is_empty(i) && cells.seq_has(i, seq_id) && cells.pos_in(i, p0, p1)) {
+            rows.emplace_back(cells.pos_get(i), i);
+        }
+    }
+
+    std::sort(rows.begin(), rows.end());
+    if (rows.size() != (size_t) (p1 - p0)) {
+        LLAMA_LOG_ERROR("%s: expected %d live positions, got %zu\n",
+                __func__, (int) (p1 - p0), rows.size());
+        return false;
+    }
+    for (size_t i = 0; i < rows.size(); ++i) {
+        if (rows[i].first != p0 + (llama_pos) i) {
+            LLAMA_LOG_ERROR("%s: non-contiguous or duplicate logical position at row %zu: got %d expected %d\n",
+                    __func__, i, rows[i].first, p0 + (llama_pos) i);
+            return false;
+        }
+    }
+
+    const std::filesystem::path root(dir);
+    std::error_code ec;
+    std::filesystem::create_directories(root, ec);
+    if (ec) {
+        LLAMA_LOG_ERROR("%s: failed to create %s: %s\n", __func__, dir, ec.message().c_str());
+        return false;
+    }
+
+    {
+        const auto path = root / (std::string(cache_name) + ".cells.tsv");
+        std::ofstream out(path, std::ios::out | std::ios::trunc);
+        if (!out) {
+            LLAMA_LOG_ERROR("%s: failed to open %s\n", __func__, path.string().c_str());
+            return false;
+        }
+        out << "cache\tstream\thead\tkv_size\tv_trans\tposition\tcell\n";
+        for (const auto & [pos, idx] : rows) {
+            out << cache_name << '\t' << stream << '\t' << v_heads[stream] << '\t'
+                << cells.size() << '\t' << (v_trans ? 1 : 0) << '\t'
+                << pos << '\t' << idx << '\n';
+        }
+    }
+
+    {
+        const auto path = root / (std::string(cache_name) + ".manifest.tsv");
+        std::ofstream out(path, std::ios::out | std::ios::trunc);
+        if (!out) {
+            LLAMA_LOG_ERROR("%s: failed to open %s\n", __func__, path.string().c_str());
+            return false;
+        }
+        out << "cache\tlayer\tkind\ttype\trow_bytes\trows\n";
+        for (const auto & layer : layers) {
+            if (layer.k == nullptr || layer.v == nullptr) {
+                LLAMA_LOG_ERROR("%s: missing K/V storage for layer %u\n", __func__, layer.il);
+                return false;
+            }
+            out << cache_name << '\t' << layer.il << "\tK\t" << ggml_type_name(layer.k->type)
+                << '\t' << ggml_row_size(layer.k->type, layer.k->ne[0]) << '\t' << rows.size() << '\n';
+            out << cache_name << '\t' << layer.il << "\tV\t" << ggml_type_name(layer.v->type)
+                << '\t' << ggml_row_size(layer.v->type, layer.v->ne[0]) << '\t' << rows.size() << '\n';
+        }
+    }
+
+    auto dump_tensor = [&](const kv_layer & layer, ggml_tensor * tensor, const char * kind) -> bool {
+        const size_t row_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
+        if (row_bytes == 0 || tensor->nb[1] < row_bytes) {
+            LLAMA_LOG_ERROR("%s: invalid row geometry for layer %u %s\n", __func__, layer.il, kind);
+            return false;
+        }
+
+        const auto path = root / (
+                std::string(cache_name) + ".layer-" + std::to_string(layer.il) + "." + kind + ".bin");
+        std::ofstream out(path, std::ios::out | std::ios::binary | std::ios::trunc);
+        if (!out) {
+            LLAMA_LOG_ERROR("%s: failed to open %s\n", __func__, path.string().c_str());
+            return false;
+        }
+
+        std::vector<uint8_t> buf(row_bytes);
+        for (const auto & [pos, idx] : rows) {
+            GGML_UNUSED(pos);
+            const size_t offset = (size_t) stream * tensor->nb[2] + (size_t) idx * tensor->nb[1];
+            if (offset + row_bytes > ggml_nbytes(tensor)) {
+                LLAMA_LOG_ERROR("%s: row out of bounds for layer %u %s, cell %u\n",
+                        __func__, layer.il, kind, idx);
+                return false;
+            }
+            ggml_backend_tensor_get(tensor, buf.data(), offset, row_bytes);
+            out.write(reinterpret_cast<const char *>(buf.data()), (std::streamsize) buf.size());
+            if (!out) {
+                LLAMA_LOG_ERROR("%s: write failed for %s\n", __func__, path.string().c_str());
+                return false;
+            }
+        }
+        return true;
+    };
+
+    for (const auto & layer : layers) {
+        if (!dump_tensor(layer, layer.k, "K") || !dump_tensor(layer, layer.v, "V")) {
+            return false;
+        }
+    }
+
+    return true;
+}
 
