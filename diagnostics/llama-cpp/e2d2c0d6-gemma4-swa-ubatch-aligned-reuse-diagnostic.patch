From: RelayLM cache diagnostic
Subject: [DIAGNOSTIC ONLY] server: align live SWA prompt reuse to physical ubatch boundary

Target: ggml-org/llama.cpp @ e2d2c0d6aa9b996d5d3a3c1d5e24c8c19728bb3d

This combines the previously successful live-SWA rollback discriminator with a
second diagnostic constraint: when the live SWA prefix is complete, reuse only
the largest positive prefix aligned to n_ubatch. This is not a production fix.

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -26,7 +26,10 @@
                                     SLT_WRN(slot, "%s\n", st1.str().c_str());
                                 }
 
-                                if (pos_min >= pos_min_thold) {
+                                const bool live_swa_prefix_complete =
+                                    has_new_tokens && n_swa > 0 && pos_min_thold == 0 && pos_min == 0;
+
+                                if (!live_swa_prefix_complete && pos_min >= pos_min_thold) {
                                     // search for a context checkpoint
                                     const auto it = std::find_if(
                                         slot.prompt.checkpoints.rbegin(),
@@ -63,6 +66,17 @@
                                         n_past = 0;
                                     }
                                 }
+
+                                if (live_swa_prefix_complete && n_ubatch > 0) {
+                                    const int32_t n_past_aligned = (n_past / n_ubatch) * n_ubatch;
+                                    if (n_past_aligned > 0 && n_past_aligned < n_past) {
+                                        // Diagnostic: preserve only complete physical ubatches so
+                                        // the reused prefix ends on the same compute boundary as
+                                        // a cold prefill with the same n_ubatch.
+                                        n_past = n_past_aligned;
+                                        pos_next = slot.prompt.tokens.pos_next(n_past);
+                                    }
+                                }
                             }
 
