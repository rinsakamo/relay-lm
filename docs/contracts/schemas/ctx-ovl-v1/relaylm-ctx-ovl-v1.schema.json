              "maximum": 256
            },
            "max_total_candidate_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 262144
            }
          }
        },
        "budget_policy_ref": {
          "$ref": "#/$defs/OperationBudgetPolicyRef"
        }
