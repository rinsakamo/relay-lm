{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relaylm:ctx-ovl-v1:schema-bundle",
  "title": "RelayCTX Session Evidence Overlay (CTX-OVL) v1 schema bundle",
  "description": "Strict target contract bundle for resolvable candidate artifacts, Contract 1 binding, operation-time TTL evaluation, session-scoped epoch fencing, and strict operation outputs.",
  "$defs": {
    "ParticipantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id_or_null",
        "identity_status"
      ],
      "properties": {
        "participant_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "identity_status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "conflicting"
          ]
        }
      }
    },
    "PartitionEpochRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_epoch_descriptor_id",
        "epoch_sequence"
      ],
      "properties": {
        "partition_epoch_descriptor_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch_sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "SourceProvenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_id",
        "evidence_space_id",
        "capture_stream_id_or_null",
        "source_access_state_at_admission"
      ],
      "properties": {
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_space_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_stream_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_access_state_at_admission": {
          "type": "string",
          "enum": [
            "admitted",
            "restricted",
            "redacted",
            "purged"
          ]
        }
      }
    },
    "CoverageCheckpointRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_coverage_checkpoint_id",
        "change_partition_id",
        "partition_epoch_id",
        "derived_coverage_status"
      ],
      "properties": {
        "change_coverage_checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "change_partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "derived_coverage_status": {
          "type": "string",
          "enum": [
            "empty_open",
            "open_contiguous",
            "open_incomplete",
            "sealed_complete",
            "sealed_incomplete",
            "unverifiable"
          ]
        }
      }
    },
    "AuthorizationWatermarkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_partition_id",
        "partition_epoch_id",
        "highest_observed_partition_sequence",
        "authority_snapshot_digest",
        "watermark_freshness"
      ],
      "properties": {
        "change_partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "highest_observed_partition_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "authority_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "watermark_freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale"
          ]
        }
      }
    },
    "AuthorizationValidationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_partition_id",
        "partition_epoch_id",
        "highest_observed_partition_sequence",
        "authority_snapshot_digest",
        "watermark_freshness",
        "validated_access_state",
        "validated_at"
      ],
      "properties": {
        "change_partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "highest_observed_partition_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "authority_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "watermark_freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale"
          ]
        },
        "validated_access_state": {
          "type": "string",
          "enum": [
            "admitted",
            "restricted",
            "redacted",
            "purged",
            "corrected_superseded"
          ]
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectionAuthorizationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_partition_id",
        "partition_epoch_id",
        "highest_observed_partition_sequence",
        "authority_snapshot_digest",
        "watermark_freshness",
        "validated_access_state",
        "validated_at",
        "authorized_participant_ids"
      ],
      "properties": {
        "change_partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "highest_observed_partition_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "authority_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "watermark_freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale"
          ]
        },
        "validated_access_state": {
          "type": "string",
          "enum": [
            "admitted",
            "restricted",
            "redacted",
            "purged",
            "corrected_superseded"
          ]
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorized_participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "Contract1Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_space_id",
        "source_event_id",
        "change_partition_id",
        "partition_epoch_id",
        "authority_snapshot_digest"
      ],
      "properties": {
        "evidence_space_id": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "change_partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ProducerArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "authority_domain",
        "producer_component",
        "session_id",
        "source_event_id",
        "evidence_space_id",
        "content_kind",
        "content_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "validated_sidecar",
            "deterministic_operation_result"
          ]
        },
        "authority_domain": {
          "const": "relayctx_candidate_artifact"
        },
        "producer_component": {
          "type": "string",
          "enum": [
            "relayctx_pipeline",
            "ctx_ovl_rebuild_process"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_space_id": {
          "type": "string",
          "minLength": 1
        },
        "content_kind": {
          "type": "string",
          "enum": [
            "opaque_bounded_text",
            "opaque_structured_reference"
          ]
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CandidateEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_kind",
        "content_kind",
        "envelope_version",
        "producer_artifact_ref",
        "content_address_space",
        "content_digest",
        "raw_source_content_present",
        "size_bound"
      ],
      "properties": {
        "envelope_kind": {
          "type": "string",
          "enum": [
            "validated_sidecar_envelope",
            "deterministic_operation_envelope"
          ]
        },
        "content_kind": {
          "type": "string",
          "enum": [
            "opaque_bounded_text",
            "opaque_structured_reference"
          ]
        },
        "envelope_version": {
          "type": "integer",
          "minimum": 1
        },
        "producer_artifact_ref": {
          "$ref": "#/$defs/ProducerArtifactRef"
        },
        "content_address_space": {
          "const": "ctx_ovl_candidate_artifact"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_source_content_present": {
          "const": false
        },
        "size_bound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded",
            "max_bytes",
            "actual_bytes"
          ],
          "properties": {
            "bounded": {
              "const": true
            },
            "max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "actual_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "CandidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_id",
        "artifact_kind",
        "authority_domain",
        "producer_component",
        "session_id",
        "source_event_id",
        "evidence_space_id",
        "content_kind",
        "content_digest",
        "actual_bytes",
        "immutable"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_candidate_artifact.v1"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "validated_sidecar",
            "deterministic_operation_result"
          ]
        },
        "authority_domain": {
          "const": "relayctx_candidate_artifact"
        },
        "producer_component": {
          "type": "string",
          "enum": [
            "relayctx_pipeline",
            "ctx_ovl_rebuild_process"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_space_id": {
          "type": "string",
          "minLength": 1
        },
        "content_kind": {
          "type": "string",
          "enum": [
            "opaque_bounded_text",
            "opaque_structured_reference"
          ]
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actual_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "immutable": {
          "const": true
        }
      }
    },
    "PartitionEpochDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "partition_epoch_descriptor_id",
        "session_id",
        "partition_kind",
        "partition_id",
        "scene_epoch_id_or_null",
        "epoch_sequence",
        "epoch_status",
        "established_by_operation",
        "established_at"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_partition_epoch.v1"
        },
        "partition_epoch_descriptor_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_kind": {
          "type": "string",
          "enum": [
            "participant",
            "shared_scene",
            "relationship",
            "quarantine"
          ]
        },
        "partition_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_epoch_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "epoch_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "epoch_status": {
          "type": "string",
          "enum": [
            "active",
            "superseded"
          ]
        },
        "established_by_operation": {
          "type": "string",
          "enum": [
            "ctx_pipeline_bootstrap",
            "relayscn_reclassification",
            "ctx_ovl_rebuild_process"
          ]
        },
        "established_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OverlayRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "overlay_record_id",
        "session_id",
        "partition_kind",
        "partition_id",
        "partition_epoch_ref",
        "participant_ref",
        "source_provenance",
        "contract1_binding",
        "last_validated_authorization",
        "candidate_envelope",
        "admission_origin",
        "created_by_actor",
        "candidate_basis",
        "visibility_scope",
        "lifecycle_state",
        "superseded_by_overlay_record_id_or_null",
        "non_shadowing",
        "quarantine_shadow_target_overlay_record_id_or_null",
        "rebuildable",
        "durable",
        "ttl_expires_at"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_overlay_record.v1"
        },
        "overlay_record_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_kind": {
          "type": "string",
          "enum": [
            "participant",
            "shared_scene",
            "relationship",
            "quarantine"
          ]
        },
        "partition_id": {
          "type": "string",
          "minLength": 1
        },
        "partition_epoch_ref": {
          "$ref": "#/$defs/PartitionEpochRef"
        },
        "participant_ref": {
          "$ref": "#/$defs/ParticipantRef"
        },
        "source_provenance": {
          "$ref": "#/$defs/SourceProvenanceRef"
        },
        "contract1_binding": {
          "$ref": "#/$defs/Contract1Binding"
        },
        "last_validated_authorization": {
          "$ref": "#/$defs/AuthorizationValidationRef"
        },
        "candidate_envelope": {
          "$ref": "#/$defs/CandidateEnvelope"
        },
        "admission_origin": {
          "type": "string",
          "enum": [
            "normal_pipeline",
            "catch_up_pipeline",
            "rebuild_pipeline"
          ]
        },
        "created_by_actor": {
          "type": "string",
          "enum": [
            "relayctx_pipeline",
            "ctx_ovl_rebuild_process"
          ]
        },
        "candidate_basis": {
          "type": "string",
          "enum": [
            "validated_sidecar",
            "explicit_deterministic_operation"
          ]
        },
        "visibility_scope": {
          "type": "string",
          "enum": [
            "participant_private",
            "relationship_scoped",
            "shared_scene_visible",
            "quarantined"
          ]
        },
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "removed",
            "quarantined_hold"
          ]
        },
        "superseded_by_overlay_record_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "non_shadowing": {
          "type": "boolean"
        },
        "quarantine_shadow_target_overlay_record_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rebuildable": {
          "const": true
        },
        "durable": {
          "const": false
        },
        "ttl_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CatchUpAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "catch_up_attempt_id",
        "session_id",
        "triggering_admitted_request_id",
        "evaluated_at",
        "pipeline_path_confirmation",
        "completeness_claimed_from",
        "coverage_checkpoint_ref",
        "authorization_watermark_ref",
        "eligible_selection_bound",
        "outcome",
        "produced_overlay_record_ids",
        "budget_policy_ref"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_catch_up_attempt.v1"
        },
        "catch_up_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "triggering_admitted_request_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "pipeline_path_confirmation": {
          "const": "normal_rel_scn_emo_int_mem_retrieval_ctx_pipeline"
        },
        "completeness_claimed_from": {
          "const": "coverage_checkpoint"
        },
        "coverage_checkpoint_ref": {
          "$ref": "#/$defs/CoverageCheckpointRef"
        },
        "authorization_watermark_ref": {
          "$ref": "#/$defs/AuthorizationWatermarkRef"
        },
        "eligible_selection_bound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded",
            "max_events",
            "max_total_candidate_bytes"
          ],
          "properties": {
            "bounded": {
              "const": true
            },
            "max_events": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "max_total_candidate_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65536
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "no_catch_up_needed",
            "bounded_catch_up_applied",
            "fail_closed_gap",
            "fail_closed_stale_watermark",
            "fail_closed_unresolved_identity",
            "fail_closed_governance_restriction"
          ]
        },
        "produced_overlay_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "budget_policy_ref": {
          "$ref": "#/$defs/OperationBudgetPolicyRef"
        }
      }
    },
    "ReflexSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reflex_snapshot_id",
        "session_id",
        "revision",
        "freshness_status",
        "scope_change_signal",
        "bounded_counts",
        "contains_raw_content",
        "exposed_to",
        "reversible_identifier_present"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_reflex_snapshot.v1"
        },
        "reflex_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "freshness_status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "scope_change_signal": {
          "type": "string",
          "enum": [
            "none",
            "possible_escalation",
            "possible_change"
          ]
        },
        "bounded_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participant_partition_count",
            "shared_scene_partition_count",
            "relationship_partition_count",
            "quarantine_partition_count"
          ],
          "properties": {
            "participant_partition_count": {
              "type": "integer",
              "minimum": 0
            },
            "shared_scene_partition_count": {
              "type": "integer",
              "minimum": 0
            },
            "relationship_partition_count": {
              "type": "integer",
              "minimum": 0
            },
            "quarantine_partition_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "contains_raw_content": {
          "const": false
        },
        "exposed_to": {
          "const": "relayatn"
        },
        "reversible_identifier_present": {
          "const": false
        }
      }
    },
    "WriteAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "write_attempt_id",
        "session_id",
        "target_overlay_record_id_or_null",
        "operation",
        "attempted_actor_component",
        "authorized_actor",
        "target_authority_domain",
        "authorized"
      ],
      "properties": {
        "schema": {
          "const": "relaylm.ctx_ovl_write_attempt.v1"
        },
        "write_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "target_overlay_record_id_or_null": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "admit",
            "update",
            "remove",
            "quarantine_transition"
          ]
        },
        "attempted_actor_component": {
          "type": "string",
          "enum": [
            "relayctx_pipeline",
            "ctx_ovl_rebuild_process",
            "relayatn",
            "external_unauthorized_actor"
          ]
        },
        "authorized_actor": {
          "type": "boolean"
        },
        "target_authority_domain": {
          "const": "ctx_ovl_working_state"
        },
        "authorized": {
          "type": "boolean"
        }
      }
    },
    "RebuildEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rebuild_event_id",
        "session_id",
        "evaluated_at",
        "triggered_by",
        "source_basis",
        "coverage_checkpoint_ref",
        "authorization_ref",
        "durable_state_claimed",
        "produced_overlay_record_ids",
        "excluded_reason_codes",
        "rebuild_bound",
