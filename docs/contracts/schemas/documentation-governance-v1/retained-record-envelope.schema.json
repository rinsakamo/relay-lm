{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaylm.local/schemas/documentation-governance-v1/retained-record-envelope.schema.json",
  "title": "RelayLM Retained Record Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_class",
    "record_id",
    "owner",
    "continuing_function",
    "current_consumers",
    "recorded_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "relaylm.documentation.retained-record-envelope.v1"
    },
    "record_class": {
      "enum": [
        "release_validation_receipt",
        "stateful_migration_receipt",
        "external_audit_record",
        "recovery_checkpoint"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "continuing_function": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "current_consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_record_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "payload": {
      "type": "object"
    }
  }
}
