{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaylm.local/schemas/documentation-governance-v1/retirement-manifest.schema.json",
  "title": "RelayLM Documentation Retirement Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "relaylm.documentation.retirement-manifest.v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "old_path",
          "last_live_commit",
          "old_blob_sha",
          "removed_by_pr",
          "replacement_paths",
          "disposition",
          "retention_reason"
        ],
        "properties": {
          "old_path": {
            "type": "string",
            "pattern": "^docs/[A-Za-z0-9._/-]+$",
            "allOf": [
              {
                "if": {
                  "type": "string"
                },
                "then": {
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                }
              },
              {
                "if": {
                  "type": "string"
                },
                "then": {
                  "not": {
                    "pattern": "//"
                  }
                }
              }
            ]
          },
          "last_live_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "old_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "removed_by_pr": {
            "type": "integer",
            "minimum": 1
          },
          "replacement_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(docs|records)/[A-Za-z0-9._/-]+$",
              "allOf": [
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "not": {
                      "pattern": "(^|/)\\.\\.?(/|$)"
                    }
                  }
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "not": {
                      "pattern": "//"
                    }
                  }
                }
              ]
            }
          },
          "disposition": {
            "enum": [
              "absorbed",
              "record_retained",
              "replaced",
              "retired_git_history_only",
              "superseded"
            ]
          },
          "retention_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "retired_git_history_only"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "replacement_paths": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "replacement_paths": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "record_retained"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "replacement_paths": {
                  "items": {
                    "type": "string",
                    "pattern": "^records/[A-Za-z0-9._/-]+$",
                    "allOf": [
                      {
                        "if": {
                          "type": "string"
                        },
                        "then": {
                          "not": {
                            "pattern": "(^|/)\\.\\.?(/|$)"
                          }
                        }
                      },
                      {
                        "if": {
                          "type": "string"
                        },
                        "then": {
                          "not": {
                            "pattern": "//"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
