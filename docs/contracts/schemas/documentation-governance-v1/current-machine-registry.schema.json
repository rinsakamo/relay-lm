{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaylm.local/schemas/documentation-governance-v1/current-machine-registry.schema.json",
  "title": "RelayLM Current Record Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "relaylm.documentation.current-record-catalog.v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "record_class",
          "media_type",
          "owner",
          "continuing_function",
          "current_consumers",
          "schema_path",
          "validator_paths",
          "authority_paths"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^records/[A-Za-z0-9._/-]+$"
          },
          "record_class": {
            "enum": [
              "current_machine_registry",
              "external_audit_record",
              "recovery_checkpoint",
              "release_validation_receipt",
              "retirement_manifest",
              "stateful_migration_receipt"
            ]
          },
          "media_type": {
            "enum": [
              "application/json",
              "application/yaml"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "continuing_function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "current_consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "schema_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^docs/contracts/schemas/[A-Za-z0-9._/-]+\\.schema\\.json$"
          },
          "validator_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+\\.py$"
            }
          },
          "authority_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^docs/[A-Za-z0-9._/-]+\\.md$"
            }
          }
        }
      }
    }
  }
}
