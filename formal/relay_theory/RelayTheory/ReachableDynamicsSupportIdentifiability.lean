/-- The relabeling relation is total from the existing safe frame. -/
theorem finKernel_relabeledDynamicsRel_total_left
    {s : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3}
    (hs : FinKernel.ReachableResidualState
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3 s) :
    ∃ t : FinKernel.FullFutureResponseSpace
        (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3,
      FinKernel.ReachableResidualState
        (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3 t ∧
      FinKernel.RelabeledIdempotentDynamicsRel3 s t := by
  rcases finKernel_allProbes_safe_reachable_classification hs with hRoot | hCollapse
  · refine ⟨FinKernel.ResidualIdentityState
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3,
      finKernel_residualIdentityState_reachable, ?_⟩
    exact Or.inl ⟨hRoot, finKernel_fullFutureResponseSpaceEq_refl _⟩
  · refine ⟨FinKernel.otherCollapseResidualExact3,
      finKernel_generated_identityResidualState_reachable
        finKernel_other_collapse_generated, ?_⟩
    exact Or.inr ⟨hCollapse, finKernel_fullFutureResponseSpaceEq_refl _⟩

/-- The relabeling relation is total from the second frame. -/
theorem finKernel_relabeledDynamicsRel_total_right
    {t : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3}
    (ht : FinKernel.ReachableResidualState
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3 t) :
    ∃ s : FinKernel.FullFutureResponseSpace
        (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3,
      FinKernel.ReachableResidualState
        (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3 s ∧
      FinKernel.RelabeledIdempotentDynamicsRel3 s t := by
  rcases finKernel_allProbes_other_reachable_classification ht with hRoot | hCollapse
  · refine ⟨FinKernel.ResidualIdentityState
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3,
      finKernel_residualIdentityState_reachable, ?_⟩
    exact Or.inl ⟨finKernel_fullFutureResponseSpaceEq_refl _, hRoot⟩
  · refine ⟨FinKernel.hiddenCollapseResidualExact3,
      finKernel_generated_identityResidualState_reachable
        finKernel_merge01_collapse_generated_safe, ?_⟩
    exact Or.inr ⟨finKernel_fullFutureResponseSpaceEq_refl _, hCollapse⟩

/-- The relabeling relation is functional on the second frame up to response equality. -/
theorem finKernel_relabeledDynamicsRel_right_functional
    {s : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3}
    {t u : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3}
    (hst : FinKernel.RelabeledIdempotentDynamicsRel3 s t)
    (hsu : FinKernel.RelabeledIdempotentDynamicsRel3 s u) :
    FinKernel.FullFutureResponseSpaceEq t u := by
  rcases hst with hst | hst <;> rcases hsu with hsu | hsu
  · exact finKernel_fullFutureResponseSpaceEq_trans hst.2
      (finKernel_fullFutureResponseSpaceEq_symm hsu.2)
  · have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hst.1) hsu.1
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hsu.1) hst.1
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · exact finKernel_fullFutureResponseSpaceEq_trans hst.2
      (finKernel_fullFutureResponseSpaceEq_symm hsu.2)

/-- The relabeling relation is functional on the first frame up to response equality. -/
theorem finKernel_relabeledDynamicsRel_left_functional
    {s u : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3}
    {t : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3}
    (hst : FinKernel.RelabeledIdempotentDynamicsRel3 s t)
    (hut : FinKernel.RelabeledIdempotentDynamicsRel3 u t) :
    FinKernel.FullFutureResponseSpaceEq s u := by
  rcases hst with hst | hst <;> rcases hut with hut | hut
  · exact finKernel_fullFutureResponseSpaceEq_trans hst.1
      (finKernel_fullFutureResponseSpaceEq_symm hut.1)
  · have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hst.2) hut.2
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hut.2) hst.2
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · exact finKernel_fullFutureResponseSpaceEq_trans hst.1
      (finKernel_fullFutureResponseSpaceEq_symm hut.1)

/-- Root is related to root. -/
theorem finKernel_relabeledDynamicsRel_root :
    FinKernel.RelabeledIdempotentDynamicsRel3
      (FinKernel.ResidualIdentityState
        (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3)
      (FinKernel.ResidualIdentityState
        (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3) := by
  exact Or.inl ⟨finKernel_fullFutureResponseSpaceEq_refl _,
    finKernel_fullFutureResponseSpaceEq_refl _⟩

/-- The relabeling relation preserves the whole source-substitution successor table. -/
theorem finKernel_relabeledDynamicsRel_successor_forward
    {sK tK uK : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3}
    {sL tL uL : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3}
    (hsRel : FinKernel.RelabeledIdempotentDynamicsRel3 sK sL)
    (htRel : FinKernel.RelabeledIdempotentDynamicsRel3 tK tL)
    (huRel : FinKernel.RelabeledIdempotentDynamicsRel3 uK uL)
    (hSuccK : FinKernel.SourceSubstitutionSuccessorRel
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3 sK tK uK) :
    FinKernel.SourceSubstitutionSuccessorRel
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3 sL tL uL := by
  rcases hsRel with hs0 | hs1 <;>
    rcases htRel with ht0 | ht1 <;>
    rcases huRel with hu0 | hu1
  · exact finKernel_successor_root_root_of_tags hs0.2 ht0.2 hu0.2
  · have hExpected := finKernel_successor_root_root_output hs0.1 ht0.1 hSuccK
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hExpected) hu1.1
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · have hExpected := finKernel_successor_root_generated_output
      finKernel_merge01_collapse_generated_safe hs0.1 ht1.1 hSuccK
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.1) hExpected
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · exact finKernel_successor_root_generated_of_tags
      finKernel_other_collapse_generated hs0.2 ht1.2 hu1.2
  · have hExpected := finKernel_successor_generated_root_output
      finKernel_merge01_collapse_generated_safe hs1.1 ht0.1 hSuccK
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.1) hExpected
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · exact finKernel_successor_generated_root_of_tags
      finKernel_other_collapse_generated hs1.2 ht0.2 hu1.2
  · have hExpected := finKernel_successor_idempotent_output
      finKernel_merge01_collapse_generated_safe finKernel_hiddenCollapse_idempotent
      hs1.1 ht1.1 hSuccK
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.1) hExpected
    exact False.elim (finKernel_allProbes_safe_root_ne_hiddenResidual hBad)
  · exact finKernel_successor_idempotent_of_tags
      finKernel_other_collapse_generated finKernel_otherCollapse_idempotent
      hs1.2 ht1.2 hu1.2

/-- The relabeling relation also reflects the whole source-substitution successor table. -/
theorem finKernel_relabeledDynamicsRel_successor_backward
    {sK tK uK : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3}
    {sL tL uL : FinKernel.FullFutureResponseSpace
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3}
    (hsRel : FinKernel.RelabeledIdempotentDynamicsRel3 sK sL)
    (htRel : FinKernel.RelabeledIdempotentDynamicsRel3 tK tL)
    (huRel : FinKernel.RelabeledIdempotentDynamicsRel3 uK uL)
    (hSuccL : FinKernel.SourceSubstitutionSuccessorRel
      (FinKernel.allProbes 3) FinKernel.otherCollapseContextFamily3 sL tL uL) :
    FinKernel.SourceSubstitutionSuccessorRel
      (FinKernel.allProbes 3) FinKernel.merge01SafeContextFamily3 sK tK uK := by
  rcases hsRel with hs0 | hs1 <;>
    rcases htRel with ht0 | ht1 <;>
    rcases huRel with hu0 | hu1
  · exact finKernel_successor_root_root_of_tags hs0.1 ht0.1 hu0.1
  · have hExpected := finKernel_successor_root_root_output hs0.2 ht0.2 hSuccL
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hExpected) hu1.2
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · have hExpected := finKernel_successor_root_generated_output
      finKernel_other_collapse_generated hs0.2 ht1.2 hSuccL
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.2) hExpected
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · exact finKernel_successor_root_generated_of_tags
      finKernel_merge01_collapse_generated_safe hs0.1 ht1.1 hu1.1
  · have hExpected := finKernel_successor_generated_root_output
      finKernel_other_collapse_generated hs1.2 ht0.2 hSuccL
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.2) hExpected
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · exact finKernel_successor_generated_root_of_tags
      finKernel_merge01_collapse_generated_safe hs1.1 ht0.1 hu1.1
  · have hExpected := finKernel_successor_idempotent_output
      finKernel_other_collapse_generated finKernel_otherCollapse_idempotent
      hs1.2 ht1.2 hSuccL
    have hBad := finKernel_fullFutureResponseSpaceEq_trans
      (finKernel_fullFutureResponseSpaceEq_symm hu0.2) hExpected
    exact False.elim (finKernel_allProbes_other_root_ne_collapseResidual hBad)
  · exact finKernel_successor_idempotent_of_tags
      finKernel_merge01_collapse_generated_safe finKernel_hiddenCollapse_idempotent
      hs1.1 ht1.1 hu1.1

/-- Explicit root-preserving isomorphism of the two unlabeled reachable successor systems. -/
def finKernel_safe_other_relabeledDynamicsCorrespondence :
    FinKernel.ReachableClassDynamicsCorrespondence
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3 := by
  exact {
    rel := FinKernel.RelabeledIdempotentDynamicsRel3
    total_left := finKernel_relabeledDynamicsRel_total_left
    total_right := finKernel_relabeledDynamicsRel_total_right
    right_functional := finKernel_relabeledDynamicsRel_right_functional
    left_functional := finKernel_relabeledDynamicsRel_left_functional
    root := finKernel_relabeledDynamicsRel_root
    successor_forward := finKernel_relabeledDynamicsRel_successor_forward
    successor_backward := finKernel_relabeledDynamicsRel_successor_backward
  }

/-- Main #2877 counterexample: same relational reachable dynamics, different realized class support. -/
theorem finKernel_relationalDynamics_does_not_identify_accessClassSupport :
    Nonempty (FinKernel.ReachableClassDynamicsCorrespondence
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3) ∧
    ¬ FinKernel.AccessClassSupportEq
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3 := by
  exact ⟨⟨finKernel_safe_other_relabeledDynamicsCorrespondence⟩,
    finKernel_allProbes_safe_other_not_accessClassSupportEq⟩

/-- Therefore the converse of #2864 fails in the current finite exact semantics. -/
theorem finKernel_relationalDynamics_does_not_imply_accessClassSupportEq :
    ¬ (∀ (P : FinKernel.ProbeFamily 3)
        (K L : FinKernel.FutureContextFamily 3),
      Nonempty (FinKernel.ReachableClassDynamicsCorrespondence P K L) →
      FinKernel.AccessClassSupportEq P K L) := by
  intro h
  exact finKernel_allProbes_safe_other_not_accessClassSupportEq
    (h (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3
      ⟨finKernel_safe_other_relabeledDynamicsCorrespondence⟩)

/-- Acceptance bundle for #2877. -/
theorem finKernel_reachable_dynamics_support_identifiability_bundle :
    FinKernel.dirac finCollapseHidden3 ≠ FinKernel.dirac finCollapseOther3 ∧
    ¬ FinKernel.GeneratedClassCovered
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3 ∧
    ¬ FinKernel.GeneratedClassCovered
      (FinKernel.allProbes 3)
      FinKernel.otherCollapseContextFamily3
      FinKernel.merge01SafeContextFamily3 ∧
    Nonempty (FinKernel.ReachableClassDynamicsCorrespondence
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3) ∧
    ¬ FinKernel.AccessClassSupportEq
      (FinKernel.allProbes 3)
      FinKernel.merge01SafeContextFamily3
      FinKernel.otherCollapseContextFamily3 := by
  exact ⟨finKernel_hidden_collapse_ne_other_collapse,
    finKernel_allProbes_safe_other_not_generatedClassCovered,
    finKernel_allProbes_other_safe_not_generatedClassCovered,
    ⟨finKernel_safe_other_relabeledDynamicsCorrespondence⟩,
    finKernel_allProbes_safe_other_not_accessClassSupportEq⟩

end RelayTheory
